<%- include('includes/header') %>

<link rel="stylesheet" href="/css/signup.css" />

<body>
  <div class="signup-container">
    <form
      onsubmit="return validateSignupForm();"
      action="/admin/signup"
      method="POST"
      enctype="multipart/form-data"
    >
      <div class="signup-frame">
        <!-- TOP -->
        <div class="signup-top">
          <h1>CREATE ADMIN ACCOUNT</h1>
          <p>Set up your Footify admin panel</p>

          <div class="signup-links">
            <a href="/admin">← Back to Home</a>
            <span>Already have access? <a href="/admin/login">Login</a></span>
          </div>
        </div>

        <!-- INPUTS -->
        <div class="signup-inputs">
          <input
            type="text"
            name="memberNick"
            class="member-nick"
            placeholder="Username"
            required
          />
          <input
            type="text"
            name="memberPhone"
            class="member-phone"
            placeholder="Phone"
            required
          />

          <input
            type="password"
            name="memberPassword"
            class="member-password"
            placeholder="Password"
            required
          />
          <input
            type="password"
            name="confirmPassword"
            class="confirm-password"
            placeholder="Confirm Password"
            required
          />
        </div>

        <!-- IMAGE UPLOAD -->
        <div class="upload-box">
          <label>Upload Logo (optional)</label>
          <input type="file" name="memberImage" class="upload-hidden" />
        </div>

        <input name="memberType" value="ADMIN" hidden />

        <!-- BUTTON -->
        <button class="signup-btn" type="submit">CREATE ACCOUNT</button>
      </div>
    </form>
  </div>

  <script src="/js/signup.js"></script>
</body>

<%- include('includes/footer') %>
