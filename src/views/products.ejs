<%- include('includes/header') %>

<link rel="stylesheet" href="/css/products.css" />

<body>
  <div class="layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">
      <!-- TOP -->
      <div class="sidebar-top">
        <a href="/admin" class="logo">FOOTIFY</a>
        <div class="divider"></div>
        <nav class="nav">
          <a href="/admin/product/all" class="nav-item">Products</a>
          <a href="/admin/user/all" class="nav-item">Users</a>
        </nav>
      </div>

      <!-- BOTTOM -->
      <div class="sidebar-bottom">
        <a href="/admin/logout" class="nav-item logout" onclick="return confirm('Do you want to logout?');">
          Logout
        </a>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="admin-menu-frame">
      <div class="board">

        <!-- PAGE HEADER -->
        <div class="board-header">
          <span class="new-dish-txt">Products</span>
          <button class="btn btn-primary" id="process-btn">+ New Product</button>
        </div>

        <!-- PRODUCTS TABLE -->
        <div class="dishes-table">
          <table class="table table-bordered table-hover">
            <thead class="thead-light">
              <tr>
                <th>#</th>
                <th>Product Name</th>
                <th>Category</th>
                <th>Brand</th>
                <th>Size</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>
              </tr>
            </thead>

            <!-- LOOP PRODUCTS: START -->
            <tbody>
              <% products.forEach(function(product, index) { %>
              <tr>
                <td>
                  <%= index + 1 %>
                </td>
                <td><%- product.productName %></td>
                <td>
                  <%= product.productCategory %>
                </td>
                <td>
                  <%= product.productBrand %>
                </td>
                <td>
                  <%= product.productSize %>
                </td>
                <td>$<%= product.productPrice %>
                </td>
                <td>
                  <%= product.productLeftCount %>
                </td>
                <td>
                  <!-- Only the option that matches the product status gets selected -->
                  <select class="spec-select new-product-status" id="<%= product._id %>">
                    <option value="PAUSE" <%=product.productStatus==='PAUSE' ? 'selected' : '' %>>PAUSE</option>
                    <option value="PROCESS" <%=product.productStatus==='PROCESS' ? 'selected' : '' %>>PROCESS
                    </option>
                    <option value="DELETE" <%=product.productStatus==='DELETE' ? 'selected' : '' %>>DELETE</option>
                  </select>
                </td>
              </tr>
              <% }) %>
              <!-- LOOP PRODUCTS: END -->

            </tbody>
          </table>
        </div>

        <!-- NEW PRODUCT FORM -->
        <form onsubmit="return validateForm()" action="/admin/product/create" method="POST" class="dish-container" id="product-form-card" enctype="multipart/form-data">
          <div class="long-input" style="display: flex; align-items: center; margin-bottom: 10px;">
            <span class="new-dish-txt">New Product Detail</span>
          </div>

          <input name="productStatus" value="PAUSE" hidden />

          <!-- PRODUCT NAME -->
          <div class="long-input">
            <label>Product Name</label>
            <input type="text" placeholder="e.g. Man United Home Kit" name="productName" class="product-name" />
          </div>

          <!-- CATEGORY -->
          <div class="half-input-frame">
            <div class="half-input">
              <label>Category</label>
              <select name="productCategory" class="product-category" id="category-select">
                <option value="">Select...</option>
                <option value="KIT">KIT</option>
                <option value="BOOTS">BOOTS</option>
                <option value="BALL">BALL</option>
                <option value="GLOVES">GLOVES</option>
              </select>
            </div>

            <!-- KIT-TYPE -->
            <div class="half-input" id="kit-type-group">
              <label>Kit Type</label>
              <select name="kitType" class="kit-type">
                <option value="">Select...</option>
                <option value="JERSEY">JERSEY</option>
                <option value="SHORTS">SHORTS</option>
                <option value="SOCKS">SOCKS</option>
              </select>
            </div>
          </div>

          <!-- BRAND -->
          <div class="half-input-frame">
            <div class="half-input">
              <label>Brand</label>
              <select name="productBrand" class="product-brand">
                <option value="">Select...</option>
                <option value="NIKE">NIKE</option>
                <option value="ADIDAS">ADIDAS</option>
                <option value="PUMA">PUMA</option>
                <option value="NEW_BALANCE">NEW BALANCE</option>
                <option value="UNDER_ARMOUR">UNDER ARMOUR</option>
                <option value="UMBRO">UMBRO</option>
              </select>
            </div>

            <!-- SIZE -->
            <div class="half-input">
              <label>Size</label>
              <select name="productSize" class="product-size">
                <option value="">Select...</option>

                <optgroup label="Clothing" data-type="CLOTHING">
                  <option>XS</option>
                  <option>S</option>
                  <option>M</option>
                  <option>L</option>
                  <option>XL</option>
                  <option>XXL</option>
                </optgroup>

                <optgroup label="Boots" data-type="BOOTS">
                  <option>EU_38</option>
                  <option>EU_39</option>
                  <option>EU_40</option>
                  <option>EU_41</option>
                  <option>EU_42</option>
                  <option>EU_43</option>
                  <option>EU_44</option>
                  <option>EU_45</option>
                </optgroup>

                <optgroup label="Ball" data-type="BALL">
                  <option>SIZE_3</option>
                  <option>SIZE_4</option>
                  <option>SIZE_5</option>
                </optgroup>

                <optgroup label="Gloves" data-type="GLOVES">
                  <option>SIZE_7</option>
                  <option>SIZE_8</option>
                  <option>SIZE_9</option>
                  <option>SIZE_10</option>
                  <option>SIZE_11</option>
                </optgroup>
              </select>
            </div>
          </div>

          <!-- PRICE -->
          <div class="half-input-frame">
            <div class="half-input">
              <label>Price ($)</label>
              <input type="number" placeholder="Price" name="productPrice" class="product-price" />
            </div>

            <!-- STOCK -->
            <div class="half-input">
              <label>Stock Count</label>
              <input type="number" placeholder="Counts" name="productLeftCount" class="product-left-count" />
            </div>
          </div>

          <!-- COLOR -->
          <div class="long-input">
            <label>Color</label>
            <input type="text" placeholder="e.g. Sky Blue & White" name="productColor" class="product-color" />
          </div>

          <!-- DESCRIPTION -->
          <div class="long-input">
            <label>Product Description</label>
            <textarea name="productDesc" class="product-desc"></textarea>
          </div>

          <!-- IMAGES -->
          <div class="img-frame">
            <label>Product Images</label>
            <div class="media-frame">
              <% for (let i=1; i <=5; i++) { %>
              <div class="upload-img-box">
                <img src="/img/upload.svg" class="upload-placeholder" id="image-section-<%= i %>" />
                <input type="file" name="productImages" class="image-<%= i %>" data-preview="image-section-<%= i %>" accept="image/*" <%=i===1 ? 'required' : '' %> />
              </div>
              <% } %>
            </div>
          </div>

          <!-- BUTTONS -->
          <div class="operation-buttons">
            <button type="button" class="btn btn-danger" id="cancel-btn">Cancel</button>
            <button type="submit" class="btn btn-primary" id="create-btn">Create</button>
          </div>

        </form>

      </div>
    </div>

  </div>

  <script src="/js/products.js"></script>
</body>

<%- include('includes/footer') %>